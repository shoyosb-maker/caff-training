<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Rutina Pecho & Hombro</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #0f172a;
      color: #f8fafc;
      min-height: 100vh;
      padding: 30px;
    }

    .container {
      max-width: 1300px;
      margin: auto;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .title {
      font-size: 2.5rem;
      font-weight: bold;
    }

    .subtitle {
      color: #94a3b8;
      margin-top: 5px;
    }

    .dashboard {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    .card {
      background: #1e293b;
      border-radius: 20px;
      padding: 22px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.35);
      transition: transform 0.3s ease;
      border: 1px solid rgba(255,255,255,0.06);
    }

    .card:hover {
      transform: translateY(-4px);
    }

    .exercise-type {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 0.8rem;
      margin-bottom: 15px;
      font-weight: bold;
    }

    .pecho {
      background: rgba(239, 68, 68, 0.2);
      color: #f87171;
    }

    .hombro {
      background: rgba(59, 130, 246, 0.2);
      color: #60a5fa;
    }

    .exercise-name {
      font-size: 1.3rem;
      font-weight: bold;
      margin-bottom: 12px;
    }

    .exercise-description {
      color: #cbd5e1;
      line-height: 1.5;
      margin-bottom: 20px;
      min-height: 72px;
    }

    .series-container {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
    }

    .serie-btn {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 12px;
      background: #334155;
      color: white;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .serie-btn:hover {
      background: #475569;
    }

    .serie-btn.completed {
      background: #22c55e;
      color: white;
    }

    .details {
      display: flex;
      justify-content: space-between;
      margin-top: 10px;
      font-size: 0.9rem;
      color: #94a3b8;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: linear-gradient(135deg, #1e293b, #111827);
      padding: 20px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.05);
    }

    .stat-number {
      font-size: 2rem;
      font-weight: bold;
      margin-top: 10px;
    }

    .progress-bar {
      width: 100%;
      height: 14px;
      background: #334155;
      border-radius: 999px;
      overflow: hidden;
      margin-top: 10px;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #22c55e, #16a34a);
      transition: width 0.3s ease;
    }

    .reset-btn {
      padding: 14px 22px;
      border: none;
      border-radius: 14px;
      background: #ef4444;
      color: white;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    .reset-btn:hover {
      background: #dc2626;
    }

    @media (max-width: 768px) {
      body {
        padding: 15px;
      }

      .container {
        width: 100%;
      }

      .title {
        font-size: 1.8rem;
        line-height: 1.2;
      }

      .subtitle {
        font-size: 0.9rem;
      }

      .header {
        flex-direction: column;
        align-items: stretch;
      }

      .reset-btn {
        width: 100%;
        text-align: center;
      }

      .dashboard {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 18px;
        border-radius: 18px;
      }

      .exercise-name {
        font-size: 1.1rem;
      }

      .exercise-description {
        font-size: 0.92rem;
        min-height: auto;
      }

      .series-container {
        flex-direction: column;
      }

      .serie-btn {
        width: 100%;
        padding: 14px;
        font-size: 0.95rem;
      }

      .details {
        flex-direction: column;
        gap: 6px;
        font-size: 0.85rem;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .stat-card {
        padding: 18px;
      }

      .stat-number {
        font-size: 1.6rem;
      }
    }

    @media (max-width: 480px) {
      .title {
        font-size: 1.5rem;
      }

      .card {
        padding: 15px;
      }

      .exercise-type {
        font-size: 0.72rem;
      }

      .exercise-name {
        font-size: 1rem;
      }

      .serie-btn {
        padding: 12px;
      }
    }
  </style>
</head>
<body>

  <div class="container">

    <div class="header">
      <div>
        <h1 class="title">Rutina Pecho & Hombro</h1>
        <p class="subtitle">Dashboard interactivo • 7 ejercicios • 3 series por ejercicio</p>
      </div>

      <button class="reset-btn" onclick="resetWorkout()">Reiniciar Rutina</button>
    </div>

    <div class="stats">
      <div class="stat-card">
        <h3>Ejercicios Totales</h3>
        <div class="stat-number">7</div>
      </div>

      <div class="stat-card">
        <h3>Series Completadas</h3>
        <div class="stat-number" id="completedSets">0 / 21</div>
      </div>

      <div class="stat-card">
        <h3>Progreso General</h3>
        <div class="progress-bar">
          <div class="progress-fill" id="progressFill"></div>
        </div>
      </div>
    </div>

    <div class="dashboard" id="dashboard"></div>

  </div>

  <script>
    const exercises = [
      {
        type: 'Pecho',
        class: 'pecho',
        name: 'Press Inclinado con Mancuernas',
        description: 'Movimiento principal para la parte superior del pecho. Controla la bajada y genera explosividad al subir.',
        reps: '10 - 12 reps'
      },
      {
        type: 'Pecho',
        class: 'pecho',
        name: 'Press Plano en Máquina',
        description: 'Mantén tensión constante en el pecho y evita bloquear completamente los codos.',
        reps: '8 - 10 reps'
      },
      {
        type: 'Pecho',
        class: 'pecho',
        name: 'Aperturas con Mancuernas',
        description: 'Enfócate en el estiramiento profundo y la contracción máxima del pectoral.',
        reps: '12 - 15 reps'
      },
      {
        type: 'Pecho',
        class: 'pecho',
        name: 'Cruce de Poleas',
        description: 'Finalizador para congestión muscular. Mantén un tempo lento y controlado.',
        reps: '15 reps'
      },
      {
        type: 'Hombro',
        class: 'hombro',
        name: 'Press Militar con Mancuernas',
        description: 'Movimiento compuesto para desarrollar fuerza y volumen en hombros.',
        reps: '8 - 10 reps'
      },
      {
        type: 'Hombro',
        class: 'hombro',
        name: 'Elevaciones Laterales',
        description: 'Eleva hasta la línea del hombro manteniendo tensión continua.',
        reps: '12 - 15 reps'
      },
      {
        type: 'Hombro',
        class: 'hombro',
        name: 'Face Pull en Polea',
        description: 'Trabaja deltoide posterior y estabilidad escapular con buena técnica.',
        reps: '15 reps'
      }
    ];

    const dashboard = document.getElementById('dashboard');

    function renderExercises() {
      dashboard.innerHTML = '';

      exercises.forEach((exercise, index) => {
        const card = document.createElement('div');
        card.className = 'card';

        card.innerHTML = `
          <span class="exercise-type ${exercise.class}">${exercise.type}</span>

          <div class="exercise-name">${exercise.name}</div>

          <div class="exercise-description">
            ${exercise.description}
          </div>

          <div class="series-container">
            <button class="serie-btn" onclick="toggleSerie(this)">Serie 1</button>
            <button class="serie-btn" onclick="toggleSerie(this)">Serie 2</button>
            <button class="serie-btn" onclick="toggleSerie(this)">Serie 3</button>
          </div>

          <div class="details">
            <span>${exercise.reps}</span>
            <span>Descanso: 60-90s</span>
          </div>
        `;

        dashboard.appendChild(card);
      });
    }

    function toggleSerie(button) {
      button.classList.toggle('completed');
      updateProgress();
    }

    function updateProgress() {
      const completed = document.querySelectorAll('.serie-btn.completed').length;
      const total = 21;

      document.getElementById('completedSets').innerText = `${completed} / ${total}`;

      const percentage = (completed / total) * 100;
      document.getElementById('progressFill').style.width = `${percentage}%`;
    }

    function resetWorkout() {
      const buttons = document.querySelectorAll('.serie-btn');
      buttons.forEach(btn => btn.classList.remove('completed'));
      updateProgress();
    }

    renderExercises();
  </script>

</body>
</html>
