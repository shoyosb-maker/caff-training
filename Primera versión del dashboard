<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover" />
  <meta name="theme-color" content="#000000" />
  <title>FST-7 · Workout Tracker</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: #000000;
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      min-height: 100vh;
      padding-bottom: 85px;
      overflow-x: hidden;
    }

    /* NAV BAR */
    .nav-bar {
      position: sticky;
      top: 0;
      background: #000000;
      border-bottom: 1px solid #1c1c1e;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 120;
      backdrop-filter: blur(0px);
    }

    .nav-title {
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .reset-link {
      background: none;
      border: none;
      color: #0095f6;
      font-weight: 600;
      font-size: 0.9rem;
      padding: 8px 12px;
      cursor: pointer;
      border-radius: 20px;
      transition: background 0.2s;
    }
    .reset-link:active {
      background: #1c1c1e;
    }

    /* BARRA PROGRESO SUPERIOR (estilo historias) */
    .story-progress-container {
      width: 100%;
      padding: 8px 12px;
      display: flex;
      gap: 5px;
      background: #000000;
      border-bottom: 1px solid #1c1c1e;
    }

    .story-segment {
      flex: 1;
      height: 4px;
      background: #2c2c2e;
      border-radius: 4px;
      overflow: hidden;
    }

    .story-fill {
      height: 100%;
      width: 0%;
      background: #ffffff;
      transition: width 0.25s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }

    /* FEED CONTAINER */
    .feed-container {
      max-width: 500px;
      margin: 0 auto;
      width: 100%;
      padding: 0 0 8px 0;
    }

    /* TARJETA EJERCICIO (estilo Instagram post) */
    .exercise-card {
      background: #000000;
      margin-bottom: 16px;
      border-bottom: 1px solid #1c1c1e;
      width: 100%;
    }

    /* HEADER */
    .post-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(45deg, #f09433, #dc2743, #bc1888);
      padding: 2px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .avatar-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: #000000;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.85rem;
    }

    .text-container {
      display: flex;
      flex-direction: column;
    }

    .username {
      font-size: 0.95rem;
      font-weight: 600;
    }

    .location {
      font-size: 0.7rem;
      color: #a8a8a8;
    }

    /* BLOQUE DESCRIPCIÓN (sin imagen, solo texto) */
    .description-card {
      background: #0c0c0d;
      margin: 4px 12px 12px 12px;
      padding: 16px;
      border-radius: 20px;
      border-left: 3px solid #f09433;
    }

    .exercise-title {
      font-size: 1rem;
      font-weight: 700;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }

    .reps-pill {
      background: #1c1c1e;
      padding: 4px 12px;
      border-radius: 30px;
      font-size: 0.7rem;
      font-weight: 500;
      color: #f09433;
    }

    .exercise-desc-text {
      font-size: 0.89rem;
      line-height: 1.45;
      color: #d1d1d6;
      margin-bottom: 12px;
    }

    .rest-info {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      color: #8e8e93;
      margin-top: 4px;
    }

    /* BOTONES SERIES (tamaño táctil grande) */
    .post-actions {
      padding: 8px 16px 12px 16px;
    }

    .series-group {
      display: flex;
      gap: 12px;
      width: 100%;
    }

    .insta-btn {
      flex: 1;
      background: #1c1c1e;
      border: none;
      color: #ffffff;
      padding: 14px 0;
      border-radius: 14px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: center;
      font-family: inherit;
      letter-spacing: -0.2px;
      box-shadow: 0 1px 0 rgba(255,255,255,0.05);
    }

    .insta-btn.active {
      background: #ffffff;
      color: #000000;
      box-shadow: 0 0 0 1px #ffffff;
    }

    .insta-btn:active {
      transform: scale(0.97);
    }

    .series-hint {
      font-size: 0.7rem;
      color: #6c6c70;
      padding: 4px 16px 20px 16px;
      letter-spacing: -0.2px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* FOOTER FIJO (MÓVIL) */
    .footer-status {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.96);
      backdrop-filter: blur(20px);
      border-top: 0.5px solid #2c2c2e;
      padding: 12px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 500px;
      margin: 0 auto;
      z-index: 120;
      width: 100%;
    }

    .counter-text {
      font-size: 0.9rem;
      font-weight: 500;
    }

    .counter-highlight {
      color: #0095f6;
      font-weight: 700;
      font-size: 1.1rem;
    }

    /* ajustes extra para móvil */
    @media (max-width: 480px) {
      .insta-btn {
        padding: 12px 0;
        font-size: 0.85rem;
      }
      .description-card {
        margin: 4px 12px 12px 12px;
      }
      .nav-title {
        font-size: 1.25rem;
      }
    }
  </style>
</head>
<body>

  <div class="nav-bar">
    <span class="nav-title">FST7_Workout</span>
    <button class="reset-link" id="resetAllBtn">Reiniciar</button>
  </div>

  <!-- Barra de progreso estilo historias (dinámica) -->
  <div class="story-progress-container" id="progressContainer"></div>

  <div class="feed-container" id="feedContainer"></div>

  <div class="footer-status">
    <span class="counter-text">🏋️ Progreso</span>
    <span class="counter-text"><span id="globalCounter" class="counter-highlight">0</span> / <span id="totalSeriesText">21</span> series</span>
  </div>

  <script>
    // ========== DATOS DE EJERCICIOS (SOLO TEXTO Y DESCRIPCIÓN DETALLADA) ==========
    const ejercicios = [
      {
        avatar: "P1",
        username: "press_inclinado",
        ubicacion: "Pecho • Superior",
        titulo: "Press Inclinado con Mancuernas",
        descripcion: "Movimiento clave para la parte superior del pecho. Controla la bajada (2 segundos), siente el estiramiento y explota en la subida. Mantén los codos a 45° para proteger los hombros. Concéntrate en la contracción del pectoral.",
        rangoReps: "10 - 12 reps",
        descanso: "⏱️ Descanso: 60-90 segundos"
      },
      {
        avatar: "P2",
        username: "press_plano",
        ubicacion: "Pecho • Plano",
        titulo: "Press Plano en Máquina",
        descripcion: "Mantén tensión constante en el pecho, evita bloquear los codos por completo. Aprieta el pectoral en cada repetición. Ideal para ganar masa y fuerza en la zona media del pecho.",
        rangoReps: "8 - 10 reps",
        descanso: "⏱️ Descanso: 60-90 segundos"
      },
      {
        avatar: "P3",
        username: "aperturas_mancuerna",
        ubicacion: "Pecho • Aperturas",
        titulo: "Aperturas con Mancuernas",
        descripcion: "Enfócate en el estiramiento profundo y la contracción máxima. Abre los brazos en arco controlado, sin dejar caer el peso. Trabaja el ancho del pectoral y mejora la definición.",
        rangoReps: "12 - 15 reps",
        descanso: "⏱️ Descanso: 60-90 segundos"
      },
      {
        avatar: "F7",
        username: "fst7_finalizer",
        ubicacion: "Pecho • Aislamiento Máximo",
        titulo: "Cruce de Poleas (FST-7)",
        descripcion: "Finalizador brutal para congestión máxima. Mantén tempo lento en negativa, cruza las manos por delante del pecho apretando al máximo. Solo 30 segundos de descanso entre series. Quemarás como nunca.",
        rangoReps: "🔥 15 reps · FST-7",
        descanso: "⏱️ Descanso estricto: 30 segundos"
      },
      {
        avatar: "H1",
        username: "military_press",
        ubicacion: "Hombro • Fuerza",
        titulo: "Press Militar con Mancuernas",
        descripcion: "Movimiento compuesto para hombros enormes. Mantén el torso firme, evita arquear la espalda. Sube las pesas en línea recta hasta extensión completa. Gran transferencia a fuerza general.",
        rangoReps: "8 - 10 reps",
        descanso: "⏱️ Descanso: 60-90 segundos"
      },
      {
        avatar: "H2",
        username: "laterales",
        ubicacion: "Hombro • Amplitud",
        titulo: "Elevaciones Laterales",
        descripcion: "Construye hombros redondos y anchura. Eleva las mancuernas hasta la altura del hombro, con ligera flexión de codo. Controla la excéntrica y evita balanceos. Tensión continua.",
        rangoReps: "12 - 15 reps",
        descanso: "⏱️ Descanso: 60-90 segundos"
      },
      {
        avatar: "H3",
        username: "remo_nuca",
        ubicacion: "Hombro • Espalda Alta",
        titulo: "Remo tras nuca",
        descripcion: "Trabaja el deltoides posterior y trapecio superior con técnica precisa. Baja la barra hacia la nuca, codos apuntando a los lados. Mejora la postura y la salud del manguito rotador.",
        rangoReps: "15 reps",
        descanso: "⏱️ Descanso: 60-90 segundos"
      }
    ];

    const TOTAL_EJERCICIOS = ejercicios.length;    // 7
    const SERIES_POR_EJERCICIO = 3;                // 3 series por ejercicio
    const TOTAL_SERIES_GLOBAL = TOTAL_EJERCICIOS * SERIES_POR_EJERCICIO;  // 21

    // Matriz de seguimiento [ejercicio][serie] -> 0 no completado, 1 completado
    let seguimiento = [];

    // Elementos DOM
    const progressContainer = document.getElementById('progressContainer');
    const feedContainer = document.getElementById('feedContainer');
    const globalCounterSpan = document.getElementById('globalCounter');
    const totalSeriesSpan = document.getElementById('totalSeriesText');
    const resetBtn = document.getElementById('resetAllBtn');

    // Inicializar matriz en 0
    function inicializarSeguimiento() {
      seguimiento = [];
      for (let i = 0; i < TOTAL_EJERCICIOS; i++) {
        seguimiento.push([0, 0, 0]);
      }
    }

    // Actualizar todas las barras de progreso y contador inferior
    function actualizarTodoElProgreso() {
      // Actualizar cada barra superior (story fill)
      for (let i = 0; i < TOTAL_EJERCICIOS; i++) {
        const completadasEnEjercicio = seguimiento[i].reduce((acc, val) => acc + val, 0);
        const porcentaje = (completadasEnEjercicio / SERIES_POR_EJERCICIO) * 100;
        const fillElement = document.getElementById(`storyFill-${i}`);
        if (fillElement) {
          fillElement.style.width = `${porcentaje}%`;
        }
      }

      // Calcular total de series completadas
      let totalHechas = 0;
      for (let i = 0; i < TOTAL_EJERCICIOS; i++) {
        totalHechas += seguimiento[i].reduce((a,b) => a + b, 0);
      }
      globalCounterSpan.innerText = totalHechas;
    }

    // Alternar estado de una serie (marcar / desmarcar)
    function toggleSerie(boton, ejercicioIdx, serieIdx) {
      const estaActivo = boton.classList.contains('active');
      if (estaActivo) {
        boton.classList.remove('active');
        seguimiento[ejercicioIdx][serieIdx] = 0;
      } else {
        boton.classList.add('active');
        seguimiento[ejercicioIdx][serieIdx] = 1;
      }
      // Actualizar visuales globales
      actualizarTodoElProgreso();
      
      // Feedback táctil si el móvil lo soporta
      if (window.navigator && window.navigator.vibrate) {
        window.navigator.vibrate(6);
      }
    }

    // Reiniciar completamente toda la rutina
    function reiniciarRutina() {
      // Resetear matriz
      for (let i = 0; i < TOTAL_EJERCICIOS; i++) {
        for (let j = 0; j < SERIES_POR_EJERCICIO; j++) {
          seguimiento[i][j] = 0;
        }
      }
      // Quitar clase active de todos los botones
      const todosLosBotones = document.querySelectorAll('.insta-btn');
      todosLosBotones.forEach(btn => {
        btn.classList.remove('active');
      });
      // Actualizar barras y contador
      actualizarTodoElProgreso();
      // Scroll suave al inicio
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Construir las barras de progreso superior (7 segmentos)
    function construirBarrasProgreso() {
      progressContainer.innerHTML = '';
      for (let i = 0; i < TOTAL_EJERCICIOS; i++) {
        const segmento = document.createElement('div');
        segmento.className = 'story-segment';
        const fill = document.createElement('div');
        fill.className = 'story-fill';
        fill.id = `storyFill-${i}`;
        fill.style.width = '0%';
        segmento.appendChild(fill);
        progressContainer.appendChild(segmento);
      }
    }

    // Construir el feed completo (cards con descripciones y botones)
    function construirFeed() {
      feedContainer.innerHTML = '';
      
      ejercicios.forEach((ej, idx) => {
        const card = document.createElement('div');
        card.className = 'exercise-card';
        
        // HEADER
        const header = document.createElement('div');
        header.className = 'post-header';
        header.innerHTML = `
          <div class="user-info">
            <div class="avatar"><div class="avatar-inner">${ej.avatar}</div></div>
            <div class="text-container">
              <span class="username">${ej.username}</span>
              <span class="location">${ej.ubicacion}</span>
            </div>
          </div>
        `;
        card.appendChild(header);
        
        // BLOQUE DESCRIPCIÓN (solo texto, sin imágenes)
        const descBlock = document.createElement('div');
        descBlock.className = 'description-card';
        descBlock.innerHTML = `
          <div class="exercise-title">
            <span>${ej.titulo}</span>
            <span class="reps-pill">🎯 ${ej.rangoReps}</span>
          </div>
          <div class="exercise-desc-text">📌 ${ej.descripcion}</div>
          <div class="rest-info">${ej.descanso}</div>
        `;
        card.appendChild(descBlock);
        
        // BOTONES DE SERIES (3)
        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'post-actions';
        const seriesGroup = document.createElement('div');
        seriesGroup.className = 'series-group';
        
        for (let s = 0; s < SERIES_POR_EJERCICIO; s++) {
          const boton = document.createElement('button');
          boton.className = 'insta-btn';
          boton.innerText = `Serie ${s+1}`;
          // Closure para mantener índices
          boton.addEventListener('click', (function(exIdx, setIdx) {
            return function() { toggleSerie(this, exIdx, setIdx); };
          })(idx, s));
          
          // Si el seguimiento ya tenía marcado (en caso de reinicio o sincronización)
          if (seguimiento[idx] && seguimiento[idx][s] === 1) {
            boton.classList.add('active');
          }
          seriesGroup.appendChild(boton);
        }
        actionsDiv.appendChild(seriesGroup);
        card.appendChild(actionsDiv);
        
        // Texto recordatorio amigable (3 series obligatorias)
        const hint = document.createElement('div');
        hint.className = 'series-hint';
        hint.innerHTML = '🔁 3 series obligatorias • completa cada una para registrar el progreso';
        card.appendChild(hint);
        
        feedContainer.appendChild(card);
      });
    }

    // Sincronizar estado de los botones después de construir (por si acaso)
    function sincronizarBotonesConTracking() {
      const todasLasCards = document.querySelectorAll('.exercise-card');
      for (let i = 0; i < todasLasCards.length && i < TOTAL_EJERCICIOS; i++) {
        const botones = todasLasCards[i].querySelectorAll('.insta-btn');
        for (let s = 0; s < botones.length && s < SERIES_POR_EJERCICIO; s++) {
          if (seguimiento[i] && seguimiento[i][s] === 1) {
            botones[s].classList.add('active');
          } else {
            botones[s].classList.remove('active');
          }
        }
      }
      actualizarTodoElProgreso();
    }

    // Inicializar aplicación con todo lo necesario para móvil
    function init() {
      inicializarSeguimiento();       // matriz en cero
      construirBarrasProgreso();      // historias arriba
      construirFeed();               // cards con descripciones
      sincronizarBotonesConTracking(); // asegurar visual correcta
      
      // Mostrar total de series en el footer
      totalSeriesSpan.innerText = TOTAL_SERIES_GLOBAL;
      globalCounterSpan.innerText = "0";
      
      // Evento de reinicio
      if (resetBtn) {
        resetBtn.addEventListener('click', (e) => {
          e.preventDefault();
          reiniciarRutina();
        });
      }
    }
    
    // Arrancar todo cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</body>
</html>
